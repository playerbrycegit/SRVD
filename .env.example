# ═══════════════════════════════════════════════════════════════════════════════
# SRVD — Environment Variable Reference
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env for local development. In production, configure these in your
# hosting provider's secret/environment settings — never commit a real .env file.
#
# Core production variables are validated by src/shared-kernel/env.ts.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── REQUIRED (all environments) ─────────────────────────────────────────────
NODE_ENV=development

# The port the combined production server listens on.
PORT=4001

# ─── REQUIRED IN PRODUCTION ONLY ─────────────────────────────────────────────

# Closed-beta runtime: SQLite file on PERSISTENT DISK, one app instance only.
# Example: file:/data/srvd.sqlite
# PostgreSQL is a future runtime migration; do not put a postgres:// URL here
# until the application data layer has actually been converted and tested.
DATABASE_URL=

# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Transactional email provider API key. Current provider implementation: Resend.
EMAIL_PROVIDER_API_KEY=

# Must be a sender address/domain verified with the email provider.
EMAIL_SENDER_ADDRESS=

# ─── OPTIONAL / FEATURE FLAGS ─────────────────────────────────────────────────

# Public origin used to build verification, reset, and Connect unsubscribe links.
# Production example: https://srvd.example.com
APP_URL=http://localhost:4002

# Dev-only standalone static server port.
WEB_PORT=4002

SESSION_TTL_DAYS=30
LOG_LEVEL=debug

# SERVD Connect email campaign kill switch.
# DEFAULT / SAFE STATE: false.
# Set to true only after:
# - real sender domain is verified,
# - provider delivery is manually tested,
# - one-click unsubscribe is verified end-to-end,
# - beta consent policy is approved,
# - support/complaint monitoring is active.
# The send endpoint also enforces max 25 selected guests per campaign and max
# 3 sent/sending email campaigns per bartender per rolling 24 hours.
CONNECT_EMAIL_SEND_ENABLED=false

# ─── DEVELOPMENT ONLY (ignored in production) ────────────────────────────────

# Allows raw verification/reset tokens in dev-only API fields. env.ts forces
# this off in production regardless of this value.
DEV_TOKEN_EXPOSURE=true
