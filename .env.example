# Stage 4 §22 / this migration's §3 environment variable convention. Copy to .env for local dev.
# Every variable actually validated by src/shared-kernel/env.ts at startup - see that file for
# exact rules (what's required in production, what defaults apply in development).

NODE_ENV=development
PORT=4001
WEB_PORT=4002
APP_URL=http://localhost:4002

# Required in production only (server refuses to start without these - verified live, see the
# TypeScript migration completion report). In development/test, absence is fine.
# DATABASE_URL: for the closed beta (SQLite-on-volume strategy) set this to the SQLite file
# path on your mounted Railway volume, e.g. DATABASE_URL=file:/data/srvd.sqlite
# (a "file:" prefix is optional). When you later migrate to PostgreSQL this becomes a real
# postgres:// connection string. Required in production either way.
DATABASE_URL=
SESSION_SECRET=
EMAIL_PROVIDER_API_KEY=
EMAIL_SENDER_ADDRESS=

SESSION_TTL_DAYS=30
LOG_LEVEL=debug

# Structurally forced to false in production regardless of this value (see env.ts) - only takes
# effect in development/test, and only to let you test closer-to-prod behavior locally.
DEV_TOKEN_EXPOSURE=true
