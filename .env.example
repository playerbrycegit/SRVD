# ═══════════════════════════════════════════════════════════════════════════════
# SRVD — Environment Variable Reference
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env for local development. In production (Railway), set these as
# service variables — never commit a real .env file.
#
# All variables are validated at startup by src/shared-kernel/env.ts.
# In production, missing required variables cause the server to refuse to start
# with a clear error message listing what's missing.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── REQUIRED (all environments) ─────────────────────────────────────────────

# Purpose:  Application environment. Controls security behavior, logging, and
#           whether the server enforces production-only requirements.
# Values:   development | test | production
# Default:  (none — must be set)
# Security: Not secret.
NODE_ENV=development

# Purpose:  Port the server listens on.
# Default:  4001
# Notes:    Railway sets $PORT automatically; do not hardcode in Railway.
# Security: Not secret.
PORT=4001

# ─── REQUIRED IN PRODUCTION ONLY ─────────────────────────────────────────────
# The server refuses to start in production without ALL of these set.

# Purpose:  Database location. For the closed beta (SQLite-on-volume), set this
#           to the SQLite file path on the mounted Railway volume.
# Example:  file:/data/srvd.sqlite  (a "file:" prefix is tolerated and stripped)
# Post-beta: This becomes a postgres:// connection string after the Postgres
#           migration.
# Security: Not secret in the SQLite case (it's a file path). Will be secret
#           once it contains Postgres credentials.
DATABASE_URL=

# Purpose:  Secret used internally for session-token generation and validation.
# Example:  (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# Security: SECRET. Never commit. Never log. Never expose in client responses.
SESSION_SECRET=

# Purpose:  API key for the transactional email provider (Resend).
# Example:  re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Security: SECRET. Stored in Railway service variables only.
EMAIL_PROVIDER_API_KEY=

# Purpose:  Verified sender address for transactional emails (verification,
#           password reset, password-changed notifications).
# Example:  noreply@yourdomain.com
# Notes:    Must be verified in your Resend account. Unverified addresses cause
#           email delivery to fail silently.
# Security: Not secret, but must match a verified domain.
EMAIL_SENDER_ADDRESS=

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Purpose:  The public-facing URL of the application (used in email links).
# Default:  http://localhost:{WEB_PORT} in dev; MUST be set in production.
# Example:  https://srvd.yourdomain.com
# Security: Not secret.
APP_URL=http://localhost:4002

# Purpose:  Port for the standalone static file server (dev mode only — in
#           production the combined server serves both API and web on $PORT).
# Default:  4002
# Security: Not secret. Not used in production.
WEB_PORT=4002

# Purpose:  How long a session token stays valid before expiring.
# Default:  30 (days)
# Security: Not secret. Lower values are more secure; 30 is reasonable for beta.
SESSION_TTL_DAYS=30

# Purpose:  Minimum severity for server log output.
# Values:   debug | info | warn | error
# Default:  debug in dev/test, info in production
# Security: Not secret.
LOG_LEVEL=debug

# ─── DEVELOPMENT ONLY (ignored in production) ────────────────────────────────

# Purpose:  Controls whether dev-only response fields (e.g. raw verification
#           tokens in register responses) are exposed. Structurally forced to
#           false in production regardless of this value — no env var can
#           override it. Only takes effect in development/test.
# Default:  true in dev/test
# Security: The production lockout is a safety invariant, not a config option.
DEV_TOKEN_EXPOSURE=true
